import React, { useState, useEffect, useRef } from 'react';

/* ─────────────────────────  utilidades  ───────────────────────── */

const CLAVE = 'panel-estudio-v1';
const uid = () => Math.random().toString(36).slice(2, 9);
const iso = (d) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const HOY = () => iso(new Date());

const DIAS_CORTOS = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
const PALETA_LISTA = ['#F5CE3F', '#4FB894', '#6FA8DC', '#E0876A', '#A78BD0', '#5FC3C9', '#D4A55E'];
const ESTADOS = [
  { id: 'por', nombre: 'Por hacer' },
  { id: 'pend', nombre: 'Pendientes' },
  { id: 'hecho', nombre: 'Completado' },
];
const estadoDe = (t) => t.estado ?? (t.hecho ? 'hecho' : 'por');
const siguienteEstado = (e) => (e === 'por' ? 'pend' : e === 'pend' ? 'hecho' : 'por');
const colorLista = (c, i) => c.color ?? PALETA_LISTA[i % PALETA_LISTA.length];

const PALETA_HAB = ['#F5CE3F', '#4FB894', '#6FA8DC', '#E0876A', '#A78BD0', '#5FC3C9', '#D4A55E'];
const colorHab = (h, i) => h.color ?? PALETA_HAB[i % PALETA_HAB.length];
const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio',
  'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

const fechaLarga = (d) =>
  `${['domingo','lunes','martes','miércoles','jueves','viernes','sábado'][d.getDay()]} ${d.getDate()} de ${MESES[d.getMonth()]}`;

const DIA_VACIO = { tareas: 0, pomodoros: 0, minutos: 0, titulos: [] };
const leerDia = (dias, k) => ({ ...DIA_VACIO, ...(dias[k] ?? {}) });

const Icono = ({ n }) => {
  const p = {
    play: 'M5 3.5v9l8-4.5z',
    pausa: 'M5.5 3.5h2.5v9h-2.5zm5 0h2.5v9h-2.5z',
    reinicio: 'M8 3a5 5 0 1 0 4.6 3M12.9 2.4v3.8h-3.8',
    mas: 'M8 3.5v9M3.5 8h9',
    baja: 'M8 2.5v8m0 0 3-3m-3 3-3-3M2.8 13.2h10.4',
  }[n];
  const relleno = n === 'play' || n === 'pausa';
  return (
    <svg viewBox="0 0 16 16" fill={relleno ? 'currentColor' : 'none'}
      stroke={relleno ? 'none' : 'currentColor'} strokeWidth="1.6"
      strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={p} />
    </svg>
  );
};

const INICIAL = {
  titulo: 'Bitácora',
  subtitulo: 'de estudio',
  tituloPanel: 'Mis listas',
  enfoque: null,
  categorias: [
    {
      id: uid(),
      nombre: 'WSL y Linux',
      temas: [
        { id: uid(), texto: 'Instalar WSL2 y elegir distro', hora: '18:00', minutos: 0, hecho: false, fecha: null },
        { id: uid(), texto: 'Sistema de archivos: /mnt/c y permisos', hora: '19:00', minutos: 0, hecho: false, fecha: null },
        { id: uid(), texto: 'Redes dentro de WSL (ip, ss, ping)', hora: null, minutos: 0, hecho: false, fecha: null },
        { id: uid(), texto: 'systemd y servicios', hora: null, minutos: 0, hecho: false, fecha: null },
      ],
    },
    {
      id: uid(),
      nombre: 'Dormir mejor',
      temas: [
        { id: uid(), texto: 'Misma hora de acostarme 7 días', hora: '23:00', minutos: 0, hecho: false, fecha: null },
        { id: uid(), texto: 'Sin pantallas 30 min antes', hora: '22:30', minutos: 0, hecho: false, fecha: null },
        { id: uid(), texto: 'Cuarto oscuro y fresco', hora: null, minutos: 0, hecho: false, fecha: null },
      ],
    },
  ],
  habitos: [
    { id: uid(), nombre: 'Estudiar 1 hora', registro: {} },
    { id: uid(), nombre: 'Dormir 7 h o más', registro: {} },
    { id: uid(), nombre: 'Leer 20 min', registro: {} },
  ],
  dias: {},
  config: { foco: 25, corto: 5, largo: 15 },
};

/* ─────────────────────────  estilos  ───────────────────────── */

const CSS = `
.pe {
  --fondo:#0F151C; --capa:#161E27; --capa2:#1C2732; --linea:#2A3743;
  --texto:#E6EAE6; --suave:#8B99A6; --tenue:#5E6B78;
  --marca:#F5CE3F; --menta:#4FB894;
  background:var(--fondo); color:var(--texto); min-height:100vh; color-scheme:dark;
  font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  font-size:15px; line-height:1.5; padding-bottom:72px;
  background-image:
    repeating-linear-gradient(to right, rgba(255,255,255,.028) 0 1px, transparent 1px 34px),
    repeating-linear-gradient(to bottom, rgba(255,255,255,.028) 0 1px, transparent 1px 34px);
}
.pe *,.pe *::before,.pe *::after{box-sizing:border-box;}
.pe button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;}
.pe input{font:inherit;color:inherit;}
.pe :focus-visible{outline:2px solid var(--menta);outline-offset:2px;border-radius:3px;}
.pe-envoltura{max-width:1080px;margin:0 auto;padding:0 20px;}

/* ── cabecera con el anillo ── */
.pe-banda{border-bottom:1px solid var(--linea);
  background:linear-gradient(180deg,rgba(79,184,148,.06),transparent 60%);}
.pe-banda-in{max-width:1080px;margin:0 auto;padding:30px 20px 28px;
  display:grid;grid-template-columns:1fr;gap:26px;align-items:center;justify-items:center;text-align:center;}
@media(min-width:840px){
  .pe-banda-in{grid-template-columns:1fr auto 1fr;text-align:left;justify-items:stretch;}
  .pe-lado-d{text-align:right;}
}
.pe-fecha{font-size:12.5px;letter-spacing:.04em;color:var(--tenue);margin-bottom:6px;}
.pe-titulo{font-size:26px;font-weight:600;letter-spacing:-.02em;line-height:1.15;}
.pe-titulo em{font-style:normal;color:var(--marca);}
.pe-sub{margin-top:8px;font-size:13.5px;color:var(--suave);}

.pe-anillo{position:relative;width:212px;height:212px;}
.pe-anillo svg{transform:rotate(-90deg);display:block;}
.pe-anillo .pista{stroke:#22303C;}
.pe-anillo .avance{transition:stroke-dashoffset 1s linear;stroke-linecap:round;}
.pe-centro{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;}
.pe-digitos{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  font-size:46px;line-height:1;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-.03em;}
.pe-etiqueta{font-size:12px;color:var(--suave);display:flex;align-items:center;gap:6px;}
.pe-punto{width:6px;height:6px;border-radius:50%;background:var(--marca);}
.pe-punto.late{animation:pe-late 2s ease-in-out infinite;}
@keyframes pe-late{0%,100%{opacity:1}50%{opacity:.25}}

/* ── texto editable ── */
.pe-editable{text-align:left;border-radius:6px;padding:1px 6px;margin-left:-6px;
  border-bottom:1px dashed transparent;transition:background .15s,border-color .15s;}
.pe-editable:hover{background:var(--capa2);border-bottom-color:var(--linea);}
.pe-edit{background:var(--capa2);border:1px solid var(--menta);border-radius:6px;
  padding:1px 6px;margin-left:-6px;font:inherit;color:inherit;max-width:100%;}
.pe-edit:focus{outline:none;}

/* ── tarea enfocada ── */
.pe-enfoque{margin-top:16px;display:flex;align-items:center;gap:10px;padding:10px 12px;
  background:var(--capa);border:1px solid var(--linea);border-left:3px solid var(--marca);
  border-radius:10px;max-width:300px;font-size:13.5px;}
.pe-enfoque.libre{border-left-color:var(--linea);color:var(--tenue);font-size:12.5px;}
.pe-enfoque small{display:block;color:var(--tenue);font-size:11px;margin-bottom:3px;}
.pe-enfoque .n{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.pe-play{opacity:0;flex:none;color:var(--suave);}
.pe-item:hover .pe-play,.pe-play:focus-visible{opacity:1;}
.pe-item.enfocado{background:rgba(245,206,63,.07);box-shadow:inset 3px 0 0 var(--marca);
  border-radius:5px;padding-left:9px;}
.pe-item.enfocado .pe-play{opacity:1;color:var(--marca);}
.pe-min{flex:none;font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--tenue);}

/* ── estados y color de lista ── */
.pe-tabs{display:flex;flex-wrap:wrap;gap:4px;padding:10px 18px;border-bottom:1px solid var(--linea);}
.pe-tab{display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:8px;
  font-size:12.5px;color:var(--suave);transition:background .15s,color .15s;}
.pe-tab:hover{color:var(--texto);background:var(--capa2);}
.pe-tab[aria-pressed="true"]{background:var(--capa2);color:var(--texto);
  box-shadow:inset 0 0 0 1px var(--linea);}
.pe-tab b{font-family:ui-monospace,Menlo,monospace;font-size:11px;font-weight:500;color:var(--tenue);}
.pe-tab[aria-pressed="true"] b{color:var(--marca);}
.pe-guion{position:absolute;left:3px;right:3px;top:50%;height:2px;margin-top:-1px;border-radius:2px;}
.pe-swatch{flex:none;width:13px;height:13px;border-radius:4px;border:1px solid rgba(255,255,255,.14);}
.pe-colores{display:flex;gap:5px;align-items:center;}
.pe-color{width:15px;height:15px;border-radius:5px;border:1px solid rgba(255,255,255,.14);
  transition:transform .12s;}
.pe-color:hover{transform:scale(1.2);}

/* ── panel de Notion ── */
.pe-notion{padding:16px 18px 18px;}
.pe-notion-vacio{font-size:13.5px;color:var(--suave);max-width:62ch;margin:0 0 14px;}
.pe-nt{display:flex;align-items:center;gap:11px;padding:9px 0;border-bottom:1px solid rgba(42,55,67,.6);}
.pe-nt:last-child{border-bottom:none;}
.pe-nt-t{flex:1;min-width:0;font-size:14px;}
.pe-nt-t small{display:block;font-size:11.5px;color:var(--tenue);margin-top:2px;}
.pe-nt-t a{color:var(--suave);text-decoration:none;border-bottom:1px dotted var(--tenue);}
.pe-sel{background:var(--capa2);border:1px solid var(--linea);border-radius:8px;
  padding:8px 12px;font-size:13px;color:var(--texto);}
.pe-error{font-size:13px;color:#E0876A;background:rgba(224,135,122,.1);
  border:1px solid rgba(224,135,122,.3);border-radius:8px;padding:10px 12px;margin-bottom:12px;}
.pe-pie-nt{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin-top:14px;}

/* ── sistema de botones ── */
.pe-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;
  border:1px solid var(--linea);background:var(--capa2);color:var(--texto);
  border-radius:9px;padding:9px 18px;font-size:13.5px;font-weight:500;letter-spacing:.01em;
  transition:background .15s,border-color .15s,color .15s,transform .07s;}
.pe-btn:hover{background:#25323F;border-color:#3A4A59;}
.pe-btn:active{transform:translateY(1px);}
.pe-btn:disabled{opacity:.4;cursor:default;transform:none;}
.pe-btn svg{width:15px;height:15px;flex:none;}
.pe-btn.primario{background:var(--marca);color:#101820;border-color:var(--marca);font-weight:600;
  box-shadow:0 0 24px rgba(245,206,63,.16);}
.pe-btn.primario:hover{background:#FFDA55;border-color:#FFDA55;}
.pe-btn.menta{background:rgba(79,184,148,.13);border-color:rgba(79,184,148,.45);color:var(--menta);}
.pe-btn.menta:hover{background:rgba(79,184,148,.22);border-color:var(--menta);}
.pe-btn.fantasma{background:transparent;border-color:transparent;color:var(--suave);}
.pe-btn.fantasma:hover{background:var(--capa2);color:var(--texto);}
.pe-btn.chico{padding:6px 12px;font-size:12.5px;border-radius:7px;}
.pe-btn.redondo{width:30px;height:30px;padding:0;border-radius:9px;}
.pe-btn.redondo svg{width:14px;height:14px;}

/* segmentado de modos */
.pe-modos{display:inline-flex;gap:3px;margin-top:18px;padding:3px;
  background:var(--capa);border:1px solid var(--linea);border-radius:11px;}
.pe-modo{padding:6px 14px;font-size:12.5px;color:var(--suave);border-radius:8px;
  transition:background .15s,color .15s;}
.pe-modo:hover{color:var(--texto);}
.pe-modo[aria-pressed="true"]{background:var(--capa2);color:var(--texto);
  box-shadow:inset 0 0 0 1px var(--linea);}
.pe-ctrl{display:flex;gap:9px;justify-content:center;margin-top:12px;}
.pe-fila-btn{display:flex;gap:8px;align-items:center;}

.pe-medidor{width:180px;height:6px;background:#22303C;border-radius:999px;overflow:hidden;margin-top:10px;}
.pe-lado-d .pe-medidor{margin-left:auto;}
.pe-medidor span{display:block;height:100%;background:var(--menta);transition:width .35s ease;}
.pe-racha-g{margin-top:14px;font-family:ui-monospace,Menlo,monospace;font-size:12.5px;color:var(--marca);}

/* ── cajas ── */
.pe-rejilla{display:grid;grid-template-columns:1fr;gap:20px;margin-top:24px;}
@media(min-width:860px){.pe-rejilla{grid-template-columns:1.65fr 1fr;align-items:start;}}
.pe-caja{background:var(--capa);border:1px solid var(--linea);border-radius:10px;overflow:hidden;}
.pe-caja-cab{display:flex;align-items:baseline;justify-content:space-between;gap:12px;
  padding:15px 18px 13px;border-bottom:1px solid var(--linea);background:var(--capa2);}
.pe-caja-cab h2{font-size:16px;font-weight:600;letter-spacing:-.01em;margin:0;}
.pe-cuenta{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--tenue);font-variant-numeric:tabular-nums;}

/* ── temas ── */
.pe-cat{padding:16px 18px 14px;}
.pe-cat + .pe-cat{border-top:1px solid var(--linea);}
.pe-cat-cab{display:flex;align-items:baseline;gap:10px;margin-bottom:4px;}
.pe-cat-cab h3{font-size:13px;font-weight:600;margin:0;flex:1;color:var(--suave);letter-spacing:.02em;}
.pe-lista{list-style:none;margin:0;padding:0;}
.pe-item{display:flex;align-items:center;gap:11px;padding:6px 0;}
.pe-item + .pe-item{border-top:1px solid rgba(42,55,67,.5);}
.pe-hora{flex:none;width:46px;}
.pe-hora input{width:46px;background:transparent;border:none;padding:0;cursor:pointer;
  font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:-.02em;color:var(--marca);}
.pe-hora.vacia input{color:#3F4C58;}
.pe-item:hover .pe-hora.vacia input{color:var(--tenue);}
.pe-hora input:focus{outline:none;color:var(--texto);}
.pe-hora input::-webkit-calendar-picker-indicator{display:none;}
.pe-marca{flex:none;width:17px;height:17px;border:1.5px solid var(--tenue);
  border-radius:5px;position:relative;transition:border-color .15s,background .15s;}
.pe-marca:hover{border-color:var(--menta);}
.pe-marca[aria-checked="true"]{background:var(--menta);border-color:var(--menta);}
.pe-marca[aria-checked="true"]::after{content:"";position:absolute;left:5px;top:1.5px;width:4px;height:9px;
  border:solid #0F151C;border-width:0 2px 2px 0;transform:rotate(43deg);}
.pe-texto{flex:1;text-align:left;font-size:14.5px;padding:0 2px;}
.pe-item.listo .pe-texto{color:var(--suave);
  background:linear-gradient(transparent 56%, rgba(245,206,63,.32) 56%, rgba(245,206,63,.32) 92%, transparent 92%);}
.pe-borra{flex:none;opacity:0;width:24px;height:24px;border-radius:7px;font-size:16px;line-height:1;
  color:var(--tenue);display:inline-flex;align-items:center;justify-content:center;
  transition:opacity .15s,background .15s,color .15s;}
.pe-borra:hover{background:rgba(224,135,122,.14);color:#E0876A;}
.pe-item:hover .pe-borra,.pe-cat-cab:hover .pe-borra,.pe-hab:hover .pe-borra,.pe-borra:focus-visible{opacity:1;}

/* ── registro diario ── */
.pe-reg{width:100%;}
.pe-reg-fila{display:grid;grid-template-columns:96px repeat(4,minmax(56px,auto)) 1fr;gap:14px;
  align-items:center;padding:11px 18px;border-bottom:1px solid var(--linea);}
.pe-reg-fila:last-child{border-bottom:none;}
.pe-reg-fila:hover{background:var(--capa2);}
.pe-reg-cab{font-size:11.5px;color:var(--tenue);padding:9px 18px;border-bottom:1px solid var(--linea);}
.pe-reg-cab .pe-reg-v{color:var(--tenue);}
.pe-reg-f{font-family:ui-monospace,Menlo,monospace;font-size:12.5px;color:var(--texto);}
.pe-reg-f small{display:block;color:var(--tenue);font-size:10.5px;}
.pe-reg-v{font-family:ui-monospace,Menlo,monospace;font-size:13px;text-align:right;color:var(--texto);}
.pe-reg-v.cero{color:#3F4C58;}
.pe-fichas{display:flex;flex-wrap:wrap;gap:5px;justify-content:flex-end;}
.pe-ficha{font-size:11px;color:var(--suave);background:var(--capa2);border:1px solid var(--linea);
  border-radius:6px;padding:2px 7px;}
.pe-reg-pie{display:flex;justify-content:center;padding:14px;}
@media(max-width:720px){
  .pe-reg-fila{grid-template-columns:1fr 1fr;gap:8px;}
  .pe-reg-cab{display:none;}
  .pe-fichas{grid-column:1/-1;justify-content:flex-start;}
}
.pe-nuevo{display:flex;align-items:center;gap:11px;margin-top:8px;}
.pe-nuevo input.txt{flex:1;background:transparent;border:none;border-bottom:1px dashed var(--linea);
  padding:6px 2px;font-size:14px;}
.pe-nuevo input::placeholder{color:var(--tenue);}
.pe-nuevo input:focus{outline:none;border-bottom-color:var(--menta);border-bottom-style:solid;}
.pe-nuevo .pe-hora input{border-bottom:1px dashed var(--linea);padding-bottom:6px;}

/* ── hábitos ── */
.pe-hab{display:flex;align-items:center;gap:11px;padding:11px 18px;border-bottom:1px solid var(--linea);}
.pe-hab:hover{background:var(--capa2);}
.pe-hab-n{flex:1;font-size:14.5px;text-align:left;}
.pe-racha{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:var(--tenue);
  border:1px solid var(--linea);border-radius:999px;padding:2px 8px;white-space:nowrap;}
.pe-racha.viva{color:var(--marca);border-color:rgba(245,206,63,.4);background:rgba(245,206,63,.08);}

/* ── mes ── */
.pe-mes{display:grid;grid-template-columns:1fr;gap:28px;padding:18px;}
@media(min-width:700px){.pe-mes{grid-template-columns:auto 1fr;gap:38px;}}
.pe-cal{display:grid;grid-template-columns:repeat(7,28px);gap:5px;}
.pe-cal-d{font-size:11px;color:var(--tenue);text-align:center;padding-bottom:2px;}
.pe-dia{width:28px;height:28px;border-radius:6px;border:1px solid var(--linea);
  font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--suave);
  display:flex;align-items:center;justify-content:center;transition:transform .12s;}
.pe-dia:hover{transform:scale(1.12);}
.pe-dia.marcado{color:#101820;border-color:transparent;font-weight:600;}
.pe-dia.hoy{box-shadow:0 0 0 1.5px var(--menta);}
.pe-dia.futuro{opacity:.35;}
.pe-leyenda{display:flex;align-items:center;gap:6px;margin-top:14px;font-size:11.5px;color:var(--tenue);}
.pe-leyenda i{width:13px;height:13px;border-radius:4px;border:1px solid var(--linea);display:block;}
.pe-barras{display:flex;flex-direction:column;gap:14px;min-width:0;}
.pe-barra-fila{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:baseline;}
.pe-barra-n{font-size:13.5px;}
.pe-barra-v{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:var(--tenue);}
.pe-barra{grid-column:1/-1;height:8px;background:#22303C;border-radius:999px;overflow:hidden;}
.pe-barra span{display:block;height:100%;background:var(--menta);border-radius:999px;transition:width .3s;}
.pe-barra.amarilla span{background:var(--marca);}
.pe-cifras{display:flex;gap:28px;margin-top:18px;padding-top:16px;border-top:1px solid var(--linea);}
.pe-cifra b{display:block;font-family:ui-monospace,Menlo,monospace;font-size:26px;font-weight:500;letter-spacing:-.03em;}
.pe-cifra span{font-size:12px;color:var(--tenue);}
.pe-vacio{padding:18px;font-size:14px;color:var(--suave);}
/* ── panel de hábitos ── */
.pe-hpanel{display:grid;grid-template-columns:1fr;gap:30px;padding:20px 18px 6px;}
@media(min-width:800px){.pe-hpanel{grid-template-columns:1fr auto;gap:40px;align-items:start;}}
.pe-anillos{display:flex;flex-wrap:wrap;gap:20px;}
.pe-anillito{width:96px;text-align:center;}
.pe-rueda{position:relative;width:88px;height:88px;margin:0 auto 8px;}
.pe-rueda svg{transform:rotate(-90deg);display:block;}
.pe-rueda .pista2{stroke:#22303C;}
.pe-rueda .avance2{stroke-linecap:round;transition:stroke-dashoffset .5s ease;}
.pe-rueda b{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:ui-monospace,Menlo,monospace;font-size:17px;font-weight:500;letter-spacing:-.02em;}
.pe-anillito small{display:block;font-size:12px;color:var(--suave);line-height:1.3;}
.pe-anillito em{font-style:normal;display:block;font-size:11px;color:var(--tenue);margin-top:3px;}

.pe-titulillo{font-size:12.5px;color:var(--tenue);margin-bottom:12px;}
.pe-semana{display:flex;gap:9px;align-items:flex-end;}
.pe-sem{width:26px;display:flex;flex-direction:column;align-items:center;gap:6px;}
.pe-sem-caja{width:100%;height:72px;display:flex;align-items:flex-end;
  background:#1A242E;border-radius:4px;overflow:hidden;}
.pe-sem-caja span{width:100%;background:var(--menta);border-radius:4px 4px 0 0;transition:height .4s ease;}
.pe-sem-d{font-size:11px;color:var(--tenue);}
.pe-sem-p{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:var(--suave);}

.pe-malla{padding:6px 18px 20px;overflow-x:auto;}
.pe-malla-cab{display:flex;align-items:center;gap:12px;padding-bottom:6px;}
.pe-malla-fila{display:flex;align-items:center;gap:12px;padding:4px 0;border-radius:5px;}
.pe-malla-fila:hover{background:var(--capa2);}
.pe-malla-n{width:140px;min-width:140px;font-size:13.5px;display:flex;align-items:center;gap:8px;}
.pe-punta{width:8px;height:8px;border-radius:2px;flex:none;}
.pe-celdas{display:flex;gap:3px;}
.pe-celda{width:12px;height:12px;border-radius:3px;border:1px solid var(--linea);flex:none;
  background:#1A242E;transition:transform .12s;}
.pe-celda:hover{transform:scale(1.35);}
.pe-celda.futura{opacity:.3;}
.pe-celda.ahora{box-shadow:0 0 0 1.5px var(--suave);}
.pe-num{width:12px;font-size:9px;color:var(--tenue);text-align:center;flex:none;
  font-family:ui-monospace,Menlo,monospace;}
.pe-malla-r{min-width:132px;text-align:right;font-family:ui-monospace,Menlo,monospace;
  font-size:11.5px;color:var(--tenue);}
.pe-malla-r b{color:var(--texto);font-weight:500;}
@media(prefers-reduced-motion:reduce){.pe *{transition:none!important;animation:none!important;}}
`;

/* ─────────────────────────  componente  ───────────────────────── */

export default function PanelEstudio() {
  const [datos, setDatos] = useState(null);
  const primeraVez = useRef(true);

  useEffect(() => {
    try {
      const crudo = localStorage.getItem(CLAVE);
      setDatos(crudo ? JSON.parse(crudo) : INICIAL);
    } catch {
      setDatos(INICIAL);
    }
  }, []);

  useEffect(() => {
    if (!datos) return;
    if (primeraVez.current) { primeraVez.current = false; return; }
    const t = setTimeout(() => {
      try { localStorage.setItem(CLAVE, JSON.stringify(datos)); } catch { /* sin espacio */ }
    }, 400);
    return () => clearTimeout(t);
  }, [datos]);

  /* ── temporizador ── */
  const [visibles, setVisibles] = useState(14);
  const [filtro, setFiltro] = useState('todas');
  const [modo, setModo] = useState('foco');
  const [restante, setRestante] = useState(25 * 60);
  const [corriendo, setCorriendo] = useState(false);

  const cfg = datos?.config ?? INICIAL.config;
  const duracion = (m) => (m === 'foco' ? cfg.foco : m === 'corto' ? cfg.corto : cfg.largo) * 60;

  useEffect(() => { if (!corriendo) setRestante(duracion(modo)); /* eslint-disable-next-line */ }, [modo, datos?.config]);

  useEffect(() => {
    if (!corriendo) return;
    const t = setInterval(() => {
      setRestante((s) => {
        if (s > 1) return s - 1;
        clearInterval(t);
        setCorriendo(false);
        pitido();
        if (modo === 'foco') acreditarEnfoque();
        return 0;
      });
    }, 1000);
    return () => clearInterval(t);
    // eslint-disable-next-line
  }, [corriendo, modo]);

  const acreditarEnfoque = () =>
    setDatos((d) => {
      const k = HOY();
      const prev = leerDia(d.dias, k);
      const en = d.enfoque;
      const categorias = !en ? d.categorias : d.categorias.map((c) =>
        c.id !== en.catId ? c : {
          ...c,
          temas: c.temas.map((t) => (t.id === en.temaId ? { ...t, minutos: (t.minutos ?? 0) + d.config.foco } : t)),
        });
      return {
        ...d,
        categorias,
        dias: { ...d.dias, [k]: { ...prev, pomodoros: prev.pomodoros + 1, minutos: prev.minutos + d.config.foco } },
      };
    });

  const pitido = () => {
    try {
      const ac = new (window.AudioContext || window.webkitAudioContext)();
      const o = ac.createOscillator(), g = ac.createGain();
      o.frequency.value = 660; o.connect(g); g.connect(ac.destination);
      g.gain.setValueAtTime(0.12, ac.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.7);
      o.start(); o.stop(ac.currentTime + 0.7);
    } catch { /* sin sonido */ }
  };

  const mmss = `${String(Math.floor(restante / 60)).padStart(2, '0')}:${String(restante % 60).padStart(2, '0')}`;

  /* ── mutaciones ── */
  const editarDia = (clave, fn) =>
    setDatos((d) => ({ ...d, dias: { ...d.dias, [clave]: fn(leerDia(d.dias, clave)) } }));

  const ponerEstado = (catId, temaId, nuevo) =>
    setDatos((d) => {
      let delta = 0, texto = '', dia = HOY();
      const categorias = d.categorias.map((c) =>
        c.id !== catId ? c : {
          ...c,
          temas: c.temas.map((t) => {
            if (t.id !== temaId) return t;
            const antes = estadoDe(t) === 'hecho';
            const ahora = nuevo === 'hecho';
            texto = t.texto;
            if (antes && !ahora) { delta = -1; if (t.fecha) dia = t.fecha; }
            if (!antes && ahora) delta = 1;
            return { ...t, estado: nuevo, hecho: ahora, fecha: ahora ? HOY() : null };
          }),
        });
      if (delta === 0) return { ...d, categorias };
      const prev = leerDia(d.dias, dia);
      const titulos = delta > 0
        ? [...prev.titulos, texto]
        : prev.titulos.filter((x, i) => i !== prev.titulos.indexOf(texto));
      return {
        ...d,
        categorias,
        dias: { ...d.dias, [dia]: { ...prev, tareas: Math.max(0, prev.tareas + delta), titulos } },
      };
    });

  const agregarTema = (catId, texto, hora) =>
    setDatos((d) => ({
      ...d,
      categorias: d.categorias.map((c) =>
        c.id !== catId ? c : { ...c, temas: [...c.temas, { id: uid(), texto, hora: hora || null, minutos: 0, estado: 'por', hecho: false, fecha: null }] }),
    }));

  const enfocar = (catId, temaId) => {
    setDatos((d) => ({ ...d, enfoque: { catId, temaId } }));
    setModo('foco');
    setRestante(duracion('foco'));
    setCorriendo(true);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const soltarEnfoque = () => { setCorriendo(false); setDatos((d) => ({ ...d, enfoque: null })); };

  const renombrar = (campo, valor) => setDatos((d) => ({ ...d, [campo]: valor }));

  const pintarCategoria = (id, color) =>
    setDatos((d) => ({ ...d, categorias: d.categorias.map((c) => (c.id === id ? { ...c, color } : c)) }));

  const importarDeNotion = (catId, tareas) =>
    setDatos((d) => ({
      ...d,
      categorias: d.categorias.map((c) =>
        c.id !== catId ? c : {
          ...c,
          temas: [...c.temas, ...tareas.map((t) => ({
            id: uid(), texto: t.titulo, hora: null, minutos: 0,
            estado: 'pend', hecho: false, fecha: null, origen: 'notion', url: t.url ?? null,
          }))],
        }),
    }));

  const renombrarCategoria = (id, nombre) =>
    setDatos((d) => ({ ...d, categorias: d.categorias.map((c) => (c.id === id ? { ...c, nombre } : c)) }));

  const cambiarHora = (catId, temaId, hora) =>
    setDatos((d) => ({
      ...d,
      categorias: d.categorias.map((c) =>
        c.id !== catId ? c : {
          ...c,
          temas: c.temas.map((t) => (t.id === temaId ? { ...t, hora: hora || null } : t)),
        }),
    }));

  const borrarTema = (catId, temaId) =>
    setDatos((d) => ({
      ...d,
      categorias: d.categorias.map((c) =>
        c.id !== catId ? c : { ...c, temas: c.temas.filter((t) => t.id !== temaId) }),
    }));

  const agregarCategoria = (nombre) =>
    setDatos((d) => ({ ...d, categorias: [...d.categorias, { id: uid(), nombre, temas: [] }] }));

  const borrarCategoria = (id) =>
    setDatos((d) => ({ ...d, categorias: d.categorias.filter((c) => c.id !== id) }));

  const alternarHabito = (id) =>
    setDatos((d) => ({
      ...d,
      habitos: d.habitos.map((h) => {
        if (h.id !== id) return h;
        const r = { ...h.registro };
        if (r[HOY()]) delete r[HOY()]; else r[HOY()] = true;
        return { ...h, registro: r };
      }),
    }));

  const agregarHabito = (nombre) =>
    setDatos((d) => ({ ...d, habitos: [...d.habitos, { id: uid(), nombre, registro: {} }] }));

  const borrarHabito = (id) =>
    setDatos((d) => ({ ...d, habitos: d.habitos.filter((h) => h.id !== id) }));

  if (!datos) {
    return (
      <div className="pe">
        <style>{CSS}</style>
        <div className="pe-envoltura" style={{ paddingTop: 44, color: '#8B99A6' }}>Abriendo tu bitácora…</div>
      </div>
    );
  }

  /* ── cálculos ── */
  const hoy = new Date();
  const clave = HOY();
  const diaHoy = leerDia(datos.dias, clave);
  const habitosHoy = datos.habitos.filter((h) => h.registro[clave]).length;
  const metaHoy = datos.habitos.length;
  const avanceHoy = metaHoy ? Math.round((habitosHoy / metaHoy) * 100) : 0;

  const conteo = { por: 0, pend: 0, hecho: 0 };
  datos.categorias.forEach((c) => c.temas.forEach((t) => { conteo[estadoDe(t)] += 1; }));

  const temaEnfocado = datos.enfoque
    ? datos.categorias.find((c) => c.id === datos.enfoque.catId)
        ?.temas.find((t) => t.id === datos.enfoque.temaId) ?? null
    : null;

  const racha = (() => {
    let n = 0;
    const d = new Date();
    for (;;) {
      const k = iso(d);
      const dd = datos.dias[k];
      const hb = datos.habitos.some((h) => h.registro[k]);
      const activo = (dd && (dd.tareas > 0 || dd.pomodoros > 0)) || hb;
      if (!activo) { if (n === 0 && k === clave) { d.setDate(d.getDate() - 1); continue; } break; }
      n++; d.setDate(d.getDate() - 1);
    }
    return n;
  })();

  const rachaHabito = (h) => {
    let n = 0; const d = new Date();
    if (!h.registro[iso(d)]) d.setDate(d.getDate() - 1);
    while (h.registro[iso(d)]) { n++; d.setDate(d.getDate() - 1); }
    return n;
  };

  const año = hoy.getFullYear(), mes = hoy.getMonth();
  const diasMes = new Date(año, mes + 1, 0).getDate();
  const offset = (new Date(año, mes, 1).getDay() + 6) % 7;
  const celdas = [...Array(offset).fill(null), ...Array.from({ length: diasMes }, (_, i) => i + 1)];

  const valorDia = (n) => {
    const k = `${año}-${String(mes + 1).padStart(2, '0')}-${String(n).padStart(2, '0')}`;
    const d = datos.dias[k] ?? { tareas: 0, pomodoros: 0 };
    return d.tareas + d.pomodoros + datos.habitos.filter((h) => h.registro[k]).length;
  };
  const tono = (v) => (v === 0 ? 'transparent'
    : v <= 2 ? 'rgba(245,206,63,.30)'
    : v <= 5 ? 'rgba(245,206,63,.62)'
    : '#F5CE3F');

  const prefijoMes = `${año}-${String(mes + 1).padStart(2, '0')}`;
  const delMes = Object.entries(datos.dias).filter(([k]) => k.startsWith(prefijoMes));
  const tareasMes = delMes.reduce((a, [, v]) => a + v.tareas, 0);
  const pomosMes = delMes.reduce((a, [, v]) => a + v.pomodoros, 0);
  const minutosMes = delMes.reduce((a, [, v]) => a + (v.minutos ?? 0), 0);
  const transcurridos = hoy.getDate();

  const mejorRacha = (h) => {
    const dias = Object.keys(h.registro).sort();
    let mejor = 0, actual = 0, previo = null;
    for (const k of dias) {
      const d = new Date(k + 'T00:00:00');
      const seguido = previo && (d - previo) === 86400000;
      actual = seguido ? actual + 1 : 1;
      if (actual > mejor) mejor = actual;
      previo = d;
    }
    return mejor;
  };

  const porSemana = DIAS_CORTOS.map((_, i) => {
    let posibles = 0, hechos = 0;
    for (let n = 1; n <= transcurridos; n++) {
      if ((new Date(año, mes, n).getDay() + 6) % 7 !== i) continue;
      const k = `${prefijoMes}-${String(n).padStart(2, '0')}`;
      posibles += datos.habitos.length;
      hechos += datos.habitos.filter((h) => h.registro[k]).length;
    }
    return posibles ? Math.round((hechos / posibles) * 100) : 0;
  });

  /* ── registro diario ── */
  const fechasRegistradas = new Set([
    ...Object.keys(datos.dias),
    ...datos.habitos.flatMap((h) => Object.keys(h.registro)),
    clave,
  ]);
  const registro = [...fechasRegistradas].sort().reverse().map((f) => {
    const d = leerDia(datos.dias, f);
    const fe = new Date(f + 'T00:00:00');
    return {
      fecha: f,
      etiqueta: `${['dom','lun','mar','mié','jue','vie','sáb'][fe.getDay()]} ${fe.getDate()} ${MESES[fe.getMonth()].slice(0, 3)}`,
      tareas: d.tareas,
      pomodoros: d.pomodoros,
      minutos: d.minutos,
      titulos: d.titulos,
      habitos: datos.habitos.filter((h) => h.registro[f]).length,
    };
  });

  const descargar = (texto, nombre, tipo) => {
    const url = URL.createObjectURL(new Blob([texto], { type: tipo }));
    const a = document.createElement('a');
    a.href = url; a.download = nombre; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  const exportarCSV = () => {
    const cab = 'fecha,temas,pomodoros,minutos,habitos_cumplidos,habitos_totales,temas_completados';
    const filas = registro.map((r) =>
      [r.fecha, r.tareas, r.pomodoros, r.minutos, r.habitos, datos.habitos.length,
        `"${r.titulos.join('; ').replace(/"/g, "'")}"`].join(','));
    descargar([cab, ...filas].join('\n'), `bitacora-${clave}.csv`, 'text/csv;charset=utf-8');
  };

  const exportarJSON = () =>
    descargar(JSON.stringify(datos, null, 2), `bitacora-respaldo-${clave}.json`, 'application/json');

  /* anillo */
  const R = 92, C = 2 * Math.PI * R;
  const progreso = restante / duracion(modo);
  const colorModo = modo === 'foco' ? '#F5CE3F' : '#4FB894';
  const nombreModo = modo === 'foco' ? 'enfoque' : modo === 'corto' ? 'pausa corta' : 'pausa larga';

  return (
    <div className="pe">
      <style>{CSS}</style>

      {/* ── cabecera ── */}
      <header className="pe-banda">
        <div className="pe-banda-in">
          <div>
            <div className="pe-fecha">{fechaLarga(hoy)}</div>
            <div className="pe-titulo">
              <TextoEditable valor={datos.titulo ?? 'Bitácora'} onCambio={(v) => renombrar('titulo', v)} />
              <br />
              <em><TextoEditable valor={datos.subtitulo ?? 'de estudio'} onCambio={(v) => renombrar('subtitulo', v)} /></em>
            </div>
            <div className="pe-sub">{diaHoy.tareas} tareas · {diaHoy.pomodoros} pomodoros hoy</div>
            {temaEnfocado ? (
              <div className="pe-enfoque">
                <div className="n">
                  <small>enfocado en</small>
                  {temaEnfocado.texto}
                </div>
                <button className="pe-btn redondo fantasma" title="Quitar el enfoque"
                  onClick={soltarEnfoque}>×</button>
              </div>
            ) : (
              <div className="pe-enfoque libre">Elige una tarea de tus listas para enfocarte en ella</div>
            )}
          </div>

          <div>
            <div className="pe-anillo">
              <svg width="212" height="212" viewBox="0 0 212 212">
                <circle className="pista" cx="106" cy="106" r={R} fill="none" strokeWidth="9" />
                <circle className="avance" cx="106" cy="106" r={R} fill="none" strokeWidth="9"
                  stroke={colorModo} strokeDasharray={C} strokeDashoffset={C * (1 - progreso)} />
              </svg>
              <div className="pe-centro">
                <div className="pe-digitos" style={{ color: corriendo ? '#E6EAE6' : '#8B99A6' }}>{mmss}</div>
                <div className="pe-etiqueta">
                  <i className={`pe-punto${corriendo ? ' late' : ''}`} style={{ background: colorModo }} />
                  {nombreModo}
                </div>
              </div>
            </div>
            <div className="pe-modos">
              {[['foco', 'Enfoque'], ['corto', 'Pausa'], ['largo', 'Pausa larga']].map(([m, etiq]) => (
                <button key={m} className="pe-modo" aria-pressed={modo === m}
                  onClick={() => { setCorriendo(false); setModo(m); }}>{etiq}</button>
              ))}
            </div>
            <div className="pe-ctrl">
              <button className={`pe-btn${corriendo ? '' : ' primario'}`} onClick={() => setCorriendo((c) => !c)}>
                <Icono n={corriendo ? 'pausa' : 'play'} />
                {corriendo ? 'Pausar' : restante === duracion(modo) ? 'Iniciar' : 'Seguir'}
              </button>
              <button className="pe-btn" title="Volver a empezar"
                onClick={() => { setCorriendo(false); setRestante(duracion(modo)); }}>
                <Icono n="reinicio" />Reiniciar
              </button>
            </div>
          </div>

          <div className="pe-lado-d">
            <div className="pe-fecha">hábitos de hoy</div>
            <div style={{ fontFamily: 'ui-monospace,Menlo,monospace', fontSize: 30, letterSpacing: '-.02em' }}>
              {habitosHoy}<span style={{ color: '#5E6B78', fontSize: 20 }}>/{metaHoy}</span>
            </div>
            <div className="pe-medidor"><span style={{ width: `${avanceHoy}%` }} /></div>
            <div className="pe-racha-g">racha de {racha} {racha === 1 ? 'día' : 'días'}</div>
          </div>
        </div>
      </header>

      <div className="pe-envoltura">
        <div className="pe-rejilla">
          {/* ── categorías ── */}
          <section>
            <div className="pe-caja">
              <div className="pe-caja-cab">
                <h2><TextoEditable valor={datos.tituloPanel ?? 'Mis listas'}
                  onCambio={(v) => renombrar('tituloPanel', v)} /></h2>
                <span className="pe-cuenta">
                  {conteo.hecho}/{datos.categorias.reduce((a, c) => a + c.temas.length, 0)}
                </span>
              </div>

              <div className="pe-tabs">
                {[{ id: 'todas', nombre: 'Todas' }, ...ESTADOS].map((e) => (
                  <button key={e.id} className="pe-tab" aria-pressed={filtro === e.id}
                    onClick={() => setFiltro(e.id)}>
                    {e.nombre}
                    <b>{e.id === 'todas'
                      ? conteo.por + conteo.pend + conteo.hecho
                      : conteo[e.id]}</b>
                  </button>
                ))}
              </div>

              {datos.categorias.length === 0 && (
                <p className="pe-vacio">Todavía no hay categorías. Crea la primera abajo.</p>
              )}

              {datos.categorias.map((c, ic) => {
                const col = colorLista(c, ic);
                const hechos = c.temas.filter((t) => estadoDe(t) === 'hecho').length;
                const ordenados = [...c.temas]
                  .filter((t) => filtro === 'todas' || estadoDe(t) === filtro)
                  .sort((a, b) => {
                    if (a.hora && b.hora) return a.hora.localeCompare(b.hora);
                    if (a.hora) return -1;
                    if (b.hora) return 1;
                    return 0;
                  });
                if (filtro !== 'todas' && ordenados.length === 0) return null;
                return (
                  <div className="pe-cat" key={c.id}>
                    <div className="pe-cat-cab">
                      <SelectorColor color={col} onCambio={(v) => pintarCategoria(c.id, v)} />
                      <h3><TextoEditable valor={c.nombre}
                        onCambio={(v) => renombrarCategoria(c.id, v)} /></h3>
                      <span className="pe-cuenta">{hechos}/{c.temas.length}</span>
                      <button className="pe-borra" title="Eliminar categoría"
                        onClick={() => borrarCategoria(c.id)}>×</button>
                    </div>
                    <ul className="pe-lista">
                      {ordenados.map((t) => {
                        const est = estadoDe(t);
                        return (
                        <li key={t.id} className={`pe-item${est === 'hecho' ? ' listo' : ''}${
                          datos.enfoque?.temaId === t.id ? ' enfocado' : ''}`}>
                          <div className={`pe-hora${t.hora ? '' : ' vacia'}`}>
                            <input type="time" value={t.hora ?? ''} aria-label={`Hora de inicio de ${t.texto}`}
                              onChange={(e) => cambiarHora(c.id, t.id, e.target.value)} />
                          </div>
                          <button className="pe-marca" role="checkbox" aria-checked={est === 'hecho'}
                            style={est === 'hecho' ? { background: col, borderColor: col }
                              : est === 'pend' ? { borderColor: col } : undefined}
                            title={`${ESTADOS.find((x) => x.id === est).nombre} · pasar a ${
                              ESTADOS.find((x) => x.id === siguienteEstado(est)).nombre.toLowerCase()}`}
                            aria-label={t.texto}
                            onClick={() => ponerEstado(c.id, t.id, siguienteEstado(est))}>
                            {est === 'pend' && <i className="pe-guion" style={{ background: col }} />}
                          </button>
                          <button className="pe-texto"
                            onClick={() => ponerEstado(c.id, t.id, siguienteEstado(est))}>{t.texto}</button>
                          {t.minutos > 0 && <span className="pe-min">{t.minutos}m</span>}
                          <button className="pe-btn redondo fantasma pe-play"
                            title="Enfocarme en esta tarea y arrancar el pomodoro"
                            onClick={() => enfocar(c.id, t.id)}><Icono n="play" /></button>
                          <button className="pe-borra" title="Eliminar tema"
                            onClick={() => borrarTema(c.id, t.id)}>×</button>
                        </li>
                        );
                      })}
                    </ul>
                    {filtro === 'todas' && (
                      <CampoTarea onEnviar={(txt, hora) => agregarTema(c.id, txt, hora)} />
                    )}
                  </div>
                );
              })}

              {filtro === 'todas' && (
                <div className="pe-cat" style={{ borderTop: '1px solid var(--linea)' }}>
                  <CampoNuevo placeholder="Nueva lista (Redes, Gym, Trabajo…)" onEnviar={agregarCategoria} />
                </div>
              )}
            </div>
          </section>

          {/* ── hábitos ── */}
          <section>
            <div className="pe-caja">
              <div className="pe-caja-cab">
                <h2>Hábitos de hoy</h2>
                <span className="pe-cuenta">{habitosHoy}/{metaHoy}</span>
              </div>
              {datos.habitos.map((h, i) => {
                const listo = !!h.registro[clave];
                const r = rachaHabito(h);
                const col = colorHab(h, i);
                return (
                  <div className={`pe-hab pe-item${listo ? ' listo' : ''}`} key={h.id}>
                    <button className="pe-marca" role="checkbox" aria-checked={listo}
                      style={listo ? { background: col, borderColor: col } : undefined}
                      aria-label={h.nombre} onClick={() => alternarHabito(h.id)} />
                    <button className="pe-hab-n pe-texto" onClick={() => alternarHabito(h.id)}>{h.nombre}</button>
                    <span className={`pe-racha${r > 0 ? ' viva' : ''}`}>{r} d</span>
                    <button className="pe-borra" title="Eliminar hábito"
                      onClick={() => borrarHabito(h.id)}>×</button>
                  </div>
                );
              })}
              <div style={{ padding: '12px 18px 16px' }}>
                <CampoNuevo placeholder="Agregar hábito" onEnviar={agregarHabito} />
              </div>
            </div>
          </section>
        </div>

        {/* ── Notion ── */}
        <div className="pe-caja" style={{ marginTop: 20 }}>
          <div className="pe-caja-cab">
            <h2>Pendientes desde Notion</h2>
            <span className="pe-cuenta">llegan como pendientes</span>
          </div>
          <PanelNotion categorias={datos.categorias} onImportar={importarDeNotion} />
        </div>

        {/* ── el mes ── */}
        <div className="pe-caja" style={{ marginTop: 20 }}>
          <div className="pe-caja-cab">
            <h2>{MESES[mes]} {año}</h2>
            <span className="pe-cuenta">entre más marcas, más amarillo</span>
          </div>
          <div className="pe-mes">
            <div>
              <div className="pe-cal">
                {DIAS_CORTOS.map((d, i) => <div className="pe-cal-d" key={i}>{d}</div>)}
                {celdas.map((n, i) => {
                  if (n === null) return <div key={i} />;
                  const v = n > hoy.getDate() ? 0 : valorDia(n);
                  return (
                    <div key={i}
                      className={`pe-dia${n === hoy.getDate() ? ' hoy' : ''}${n > hoy.getDate() ? ' futuro' : ''}${v > 0 ? ' marcado' : ''}`}
                      style={{ background: tono(v) }}
                      title={`${n} de ${MESES[mes]}: ${v} marcas`}>{n}</div>
                  );
                })}
              </div>
              <div className="pe-leyenda">
                menos
                <i style={{ background: 'transparent' }} />
                <i style={{ background: 'rgba(245,206,63,.30)' }} />
                <i style={{ background: 'rgba(245,206,63,.62)' }} />
                <i style={{ background: '#F5CE3F' }} />
                más
              </div>
              <div className="pe-cifras">
                <div className="pe-cifra"><b>{tareasMes}</b><span>temas del mes</span></div>
                <div className="pe-cifra"><b>{pomosMes}</b><span>pomodoros</span></div>
                <div className="pe-cifra"><b>{Math.round(minutosMes / 60)}</b><span>horas de enfoque</span></div>
                <div className="pe-cifra"><b>{racha}</b><span>días seguidos</span></div>
              </div>
            </div>

            <div className="pe-barras">
              {datos.categorias.map((c, ic) => {
                const total = c.temas.length || 1;
                const hechos = c.temas.filter((t) => estadoDe(t) === 'hecho').length;
                const col = colorLista(c, ic);
                return (
                  <div className="pe-barra-fila" key={c.id}>
                    <div className="pe-barra-n">
                      <i className="pe-punta" style={{ background: col, display: 'inline-block', marginRight: 7 }} />
                      {c.nombre}
                    </div>
                    <div className="pe-barra-v">{Math.round((hechos / total) * 100)}%</div>
                    <div className="pe-barra">
                      <span style={{ width: `${(hechos / total) * 100}%`, background: col }} />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* ── hábitos del mes ── */}
        <div className="pe-caja" style={{ marginTop: 20 }}>
          <div className="pe-caja-cab">
            <h2>Hábitos · {MESES[mes]}</h2>
            <span className="pe-cuenta">{transcurridos} días corridos</span>
          </div>

          {datos.habitos.length === 0 ? (
            <p className="pe-vacio">Agrega un hábito arriba y aquí verás cómo lo sostienes.</p>
          ) : (
            <>
              <div className="pe-hpanel">
                <div className="pe-anillos">
                  {datos.habitos.map((h, i) => {
                    const col = colorHab(h, i);
                    const cumplidos = Object.keys(h.registro).filter((k) => k.startsWith(prefijoMes)).length;
                    const pct = Math.min(100, Math.round((cumplidos / transcurridos) * 100));
                    const r = 34, c = 2 * Math.PI * r;
                    return (
                      <div className="pe-anillito" key={h.id}>
                        <div className="pe-rueda">
                          <svg width="88" height="88" viewBox="0 0 88 88">
                            <circle className="pista2" cx="44" cy="44" r={r} fill="none" strokeWidth="8" />
                            <circle className="avance2" cx="44" cy="44" r={r} fill="none" strokeWidth="8"
                              stroke={col} strokeDasharray={c} strokeDashoffset={c * (1 - pct / 100)} />
                          </svg>
                          <b style={{ color: col }}>{pct}%</b>
                        </div>
                        <small>{h.nombre}</small>
                        <em>{cumplidos} de {transcurridos} días</em>
                      </div>
                    );
                  })}
                </div>

                <div>
                  <div className="pe-titulillo">cómo cumples según el día de la semana</div>
                  <div className="pe-semana">
                    {porSemana.map((p, i) => (
                      <div className="pe-sem" key={i} title={`${p}% de cumplimiento`}>
                        <div className="pe-sem-p">{p}</div>
                        <div className="pe-sem-caja">
                          <span style={{
                            height: `${Math.max(p ? 4 : 0, p)}%`,
                            background: p >= 70 ? '#4FB894' : p >= 40 ? '#F5CE3F' : '#E0876A',
                          }} />
                        </div>
                        <div className="pe-sem-d">{DIAS_CORTOS[i]}</div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div className="pe-malla">
                <div className="pe-malla-cab">
                  <div className="pe-malla-n" />
                  <div className="pe-celdas">
                    {Array.from({ length: diasMes }, (_, i) => i + 1).map((n) => (
                      <div className="pe-num" key={n}>{n % 5 === 0 || n === 1 ? n : ''}</div>
                    ))}
                  </div>
                  <div className="pe-malla-r">racha · récord</div>
                </div>

                {datos.habitos.map((h, i) => {
                  const col = colorHab(h, i);
                  return (
                    <div className="pe-malla-fila" key={h.id}>
                      <div className="pe-malla-n">
                        <i className="pe-punta" style={{ background: col }} />{h.nombre}
                      </div>
                      <div className="pe-celdas">
                        {Array.from({ length: diasMes }, (_, k) => k + 1).map((n) => {
                          const clave2 = `${prefijoMes}-${String(n).padStart(2, '0')}`;
                          const hecho = !!h.registro[clave2];
                          const futuro = n > transcurridos;
                          return (
                            <div key={n}
                              className={`pe-celda${futuro ? ' futura' : ''}${n === transcurridos ? ' ahora' : ''}`}
                              style={hecho ? { background: col, borderColor: col } : undefined}
                              title={`${n} de ${MESES[mes]} · ${hecho ? 'cumplido' : 'sin marcar'}`} />
                          );
                        })}
                      </div>
                      <div className="pe-malla-r">
                        <b>{rachaHabito(h)} d</b> · récord {mejorRacha(h)} d
                      </div>
                    </div>
                  );
                })}
              </div>
            </>
          )}
        </div>

        {/* ── registro diario ── */}
        <div className="pe-caja" style={{ marginTop: 20 }}>
          <div className="pe-caja-cab">
            <h2>Registro diario</h2>
            <div className="pe-fila-btn">
              <button className="pe-btn chico" onClick={exportarCSV}><Icono n="baja" />CSV</button>
              <button className="pe-btn chico fantasma" onClick={exportarJSON}>Respaldo</button>
            </div>
          </div>

          {registro.length === 0 ? (
            <p className="pe-vacio">Aquí se irá guardando cada día: temas, pomodoros, minutos de enfoque y hábitos.</p>
          ) : (
            <div className="pe-reg">
              <div className="pe-reg-fila pe-reg-cab">
                <div>día</div>
                <div className="pe-reg-v">temas</div>
                <div className="pe-reg-v">pomos</div>
                <div className="pe-reg-v">min</div>
                <div className="pe-reg-v">hábitos</div>
                <div className="pe-reg-v">qué completaste</div>
              </div>
              {registro.slice(0, visibles).map((r) => (
                <div className="pe-reg-fila" key={r.fecha}>
                  <div className="pe-reg-f">
                    {r.etiqueta}<small>{r.fecha}</small>
                  </div>
                  <div className={`pe-reg-v${r.tareas ? '' : ' cero'}`}>{r.tareas}</div>
                  <div className={`pe-reg-v${r.pomodoros ? '' : ' cero'}`}>{r.pomodoros}</div>
                  <div className={`pe-reg-v${r.minutos ? '' : ' cero'}`}>{r.minutos}</div>
                  <div className={`pe-reg-v${r.habitos ? '' : ' cero'}`}>{r.habitos}/{datos.habitos.length}</div>
                  <div className="pe-fichas">
                    {r.titulos.length === 0
                      ? <span className="pe-ficha" style={{ opacity: .5 }}>sin temas marcados</span>
                      : r.titulos.map((t, i) => <span className="pe-ficha" key={i}>{t}</span>)}
                  </div>
                </div>
              ))}
              {registro.length > visibles && (
                <div className="pe-reg-pie">
                  <button className="pe-btn chico" onClick={() => setVisibles((v) => v + 14)}>
                    Ver 14 días más
                  </button>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function SelectorColor({ color, onCambio }) {
  const [abierto, setAbierto] = useState(false);
  if (abierto) {
    return (
      <div className="pe-colores">
        {PALETA_LISTA.map((c) => (
          <button key={c} className="pe-color" style={{ background: c }} title={`Usar este color`}
            onClick={() => { onCambio(c); setAbierto(false); }} />
        ))}
      </div>
    );
  }
  return (
    <button className="pe-swatch" style={{ background: color }} title="Cambiar el color de la lista"
      onClick={() => setAbierto(true)} />
  );
}

function PanelNotion({ categorias, onImportar }) {
  const [cargando, setCargando] = useState(false);
  const [error, setError] = useState(null);
  const [tareas, setTareas] = useState(null);
  const [elegidas, setElegidas] = useState({});
  const [destino, setDestino] = useState(categorias[0]?.id ?? '');

  const traer = async () => {
    setCargando(true); setError(null);
    try {
      const r = await fetch('/api/notion/pendientes');
      const data = await r.json();
      if (!r.ok) throw new Error(data.error ?? 'respuesta con error');
      const lista = data.tareas ?? [];
      setTareas(lista);
      setElegidas(Object.fromEntries(lista.map((_, i) => [i, true])));
    } catch (e) {
      setError('No se pudieron leer las tareas de Notion: ' + e.message
        + '. Revisa NOTION_TOKEN y NOTION_DATABASE_ID en tu archivo .env.');
    } finally {
      setCargando(false);
    }
  };

  const seleccionadas = (tareas ?? []).filter((_, i) => elegidas[i]);

  return (
    <div className="pe-notion">
      {error && <div className="pe-error">{error}</div>}

      {!tareas && (
        <p className="pe-notion-vacio">
          Trae los pendientes que ya tienes en Notion y conviértelos en tareas de esta bitácora,
          con su hora de inicio y su pomodoro.
        </p>
      )}

      {tareas && tareas.length === 0 && (
        <p className="pe-notion-vacio">No aparecieron tareas pendientes en tu Notion.</p>
      )}

      {tareas && tareas.map((t, i) => (
        <div className="pe-nt" key={i}>
          <button className="pe-marca" role="checkbox" aria-checked={!!elegidas[i]} aria-label={t.titulo}
            style={elegidas[i] ? { background: '#4FB894', borderColor: '#4FB894' } : undefined}
            onClick={() => setElegidas((e) => ({ ...e, [i]: !e[i] }))} />
          <div className="pe-nt-t">
            {t.titulo}
            <small>
              {[t.estado, t.fecha].filter(Boolean).join(' · ') || 'sin estado'}
              {t.url && <> · <a href={t.url} target="_blank" rel="noreferrer">abrir en Notion</a></>}
            </small>
          </div>
        </div>
      ))}

      <div className="pe-pie-nt">
        <button className="pe-btn" onClick={traer} disabled={cargando}>
          {cargando ? 'Buscando en Notion…' : tareas ? 'Volver a buscar' : 'Traer mis pendientes'}
        </button>

        {seleccionadas.length > 0 && (
          <>
            <select className="pe-sel" value={destino} onChange={(e) => setDestino(e.target.value)}>
              {categorias.map((c) => <option key={c.id} value={c.id}>{c.nombre}</option>)}
            </select>
            <button className="pe-btn primario" disabled={!destino}
              onClick={() => { onImportar(destino, seleccionadas); setTareas(null); }}>
              <Icono n="mas" />Agregar {seleccionadas.length} a la lista
            </button>
          </>
        )}
      </div>
    </div>
  );
}

function TextoEditable({ valor, onCambio }) {
  const [editando, setEditando] = useState(false);
  const [v, setV] = useState(valor);
  useEffect(() => { setV(valor); }, [valor]);
  const guardar = () => {
    setEditando(false);
    const t = v.trim();
    if (t && t !== valor) onCambio(t); else setV(valor);
  };
  if (editando) {
    return (
      <input className="pe-edit" autoFocus value={v} size={Math.max(6, v.length)}
        onChange={(e) => setV(e.target.value)} onBlur={guardar}
        onKeyDown={(e) => {
          if (e.key === 'Enter') guardar();
          if (e.key === 'Escape') { setV(valor); setEditando(false); }
        }} />
    );
  }
  return (
    <button className="pe-editable" title="Clic para renombrar"
      onClick={() => setEditando(true)}>{valor}</button>
  );
}

function CampoTarea({ onEnviar }) {
  const [v, setV] = useState('');
  const [hora, setHora] = useState('');
  const enviar = () => {
    if (!v.trim()) return;
    onEnviar(v.trim(), hora);
    setV(''); setHora('');
  };
  return (
    <div className="pe-nuevo">
      <div className={`pe-hora${hora ? '' : ' vacia'}`}>
        <input type="time" value={hora} aria-label="Hora de inicio"
          onChange={(e) => setHora(e.target.value)}
          onKeyDown={(e) => { if (e.key === 'Enter') enviar(); }} />
      </div>
      <input className="txt" value={v} placeholder="Agregar tema"
        onChange={(e) => setV(e.target.value)}
        onKeyDown={(e) => { if (e.key === 'Enter') enviar(); }} />
      <button className="pe-btn redondo menta" disabled={!v.trim()} onClick={enviar}
        title="Agregar tema"><Icono n="mas" /></button>
    </div>
  );
}

function CampoNuevo({ placeholder, onEnviar }) {
  const [v, setV] = useState('');
  return (
    <div className="pe-nuevo">
      <input
        className="txt"
        value={v}
        placeholder={placeholder}
        onChange={(e) => setV(e.target.value)}
        onKeyDown={(e) => {
          if (e.key === 'Enter' && v.trim()) { onEnviar(v.trim()); setV(''); }
        }}
      />
      <button className="pe-btn redondo menta" disabled={!v.trim()} title="Agregar"
        onClick={() => { if (v.trim()) { onEnviar(v.trim()); setV(''); } }}><Icono n="mas" /></button>
    </div>
  );
}
