# Copia este archivo como .env y llena los dos valores.
# 1. Crea una integración interna en https://www.notion.so/my-integrations
#    y copia el "Internal Integration Secret".
NOTION_TOKEN=ntn_pon_aqui_tu_token

# 2. Abre tu base de datos de tareas en Notion, copia la URL y toma
#    el bloque de 32 caracteres que va antes del "?v=".
NOTION_DATABASE_ID=pon_aqui_el_id_de_32_caracteres

# Puerto del servidor (opcional, por defecto 8787)
PORT=8787
